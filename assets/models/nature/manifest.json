 "generator": "tools/blender/nat_atlas.py, nat_trees.py, nat_plants.py, nat_rocks.py, nat_finalize.py",
 "conventions": {
  "axes": "all vectors below are in glTF / three.js axes: [x, y (up), z]; meters; origin = base on the ground",
  "lod": "every .glb holds mesh nodes <asset>_LOD0 and (trees, boulders) <asset>_LOD1; LOD1 replaces LOD0 at ~70 m; trees switch to the impostor billboard further away",
  "vertex_color": "COLOR_0 (linear): R = ambient occlusion (multiply albedo), G = wind flutter weight (0 rigid .. 1 leaf tips), B = random phase per branch / leaf cluster. Rocks, stump, log: G = B = 0. EXCEPTIONS: flowers_a (M_flowers) and mushrooms (M_mushroom): RGB = actual linear colour.",
  "foliage_normals": "foliage vertices carry custom normals = normalize(0.3 * puffy outward (crown ellipsoid + local clump) + 0.7 * up). Render M_leaves double sided and do NOT flip the normal on back faces. (Weights are the w_global / w_local / w_up arguments of finish_tree in nat_common.py.)",
  "uv": "foliage UVs address leaves_a.png in glTF convention (v = 0 at the TOP of the image): load the atlas with texture.flipY = false. Bark UV: u = around the trunk (texture repeats), v = metres along the branch (1 m per tile). Rock UV: box projection, 4 m per tile.",
  "collider": "cylinder: vertical, radius = trunk at chest height, centred on the origin, use the tree height; box: size [x, y, z] + center; sphere: radius + center. None = walk-through.",
  "ground": "trunks/roots/rocks continue 0.1-1.0 m below y = 0 so that they stay planted on slopes"
 },
 "materials": {
  "M_leaves": "alpha-tested (cutoff 0.5), double sided foliage: assets/textures/leaves_a.png (+ leaves_n.png: RG = normal, B = roughness). Albedo x COLOR_0.R; wind from COLOR_0.G/B.",
  "M_flowers": "NEW. Same atlas and alpha test as M_leaves, but COLOR_0.rgb is a tint multiplied with the texture (white flower heads become coloured); no wind attributes (sway by height).",
  "M_mushroom": "NEW. Opaque, no texture needed (or a faint detail map): COLOR_0.rgb is the albedo, roughness ~0.6.",
  "M_bark_oak": "oak, willow, dead_a, stump, log, bush_b stems",
  "M_bark_pine": "pine_a, pine_b, dead_b",
  "M_bark_birch": "birch_a",
  "M_rock": "rocks, cliffs, pebbles"
 },
