 "morph_notes": {
  "order": "every mesh carries the same 50 targets in this order (zero deltas where unaffected)",
  "negative": "weights down to min are valid: negative = linear opposite",
  "eyes": "eye_L / eye_R follow every morph except the expressions (blink, mouth_open, smile, angry)",
  "feminine": "female body type on the same skeleton; suggested extra root scale 0.94 for an average woman",
  "fields": "tools/blender/human_morphs.py exposes MORPHS[name](points Nx3) -> deltas, the same analytic fields can be evaluated on hair / outfits / props",
  "jaw_open_deg": 17.0
 },
 "vertex_colors": {
  "attribute": "COLOR_0 (linear)",
  "R": "blush mask (cheeks 0.35, nose tip, ears, knuckles, elbows, knees 0.25)",
  "G": "ambient occlusion / cavity (1 = open); the upper eyelid margin is darkened on purpose (lash line)",
  "B": "lips mask",
  "A": "1",
  "note": "only meaningful on M_skin. eyes and brows are white; M_mouth uses COLOR_0 as albedo"
 },
 "uv": {
  "TEXCOORD_0": "skin: cylindrical / planar projections, about 0.5 m per UV unit (tiling pore detail, seams between body parts). eyes: planar from the front, pupil at (0.5, 0.5), the eyeball silhouette fills 0..1",
  "TEXCOORD_1": "body_head only: planar projection from the front for decals (war paint, scars). u = 0.5 + x / 0.1870 (u=0 at the character RIGHT ear, u=1 at the LEFT ear, i.e. the image is the face as seen from the front), v = (z - 1.5725) / 0.1875 (0 = under the chin, 1 = top of the forehead). Blender convention (v up); the back of the head mirrors the front, mask decals with the normal."
 },
 "materials": {
  "M_skin": "contract material (engine skin shader: skin tone uniform + COLOR_0 masks)",
  "M_eye": "contract material (engine eye shader), mesh eye_L / eye_R",
  "M_hair": "contract material, mesh brows = eyebrows + upper eyelashes (thin double sided strips that follow blink; the feminine morph lengthens them), vertex colour white, UV u along / v across",
  "M_mouth": "NEW: mouth interior and teeth. Opaque, single sided, albedo = COLOR_0 (dark red cavity, pink tongue area, ivory teeth), roughness about 0.45, no texture. Only visible when mouth_open > 0."
 },
